generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon pgbouncer) connection used by the application
  directUrl = env("DIRECT_URL")   // direct connection used by prisma migrate
}
model Team {
  id String @id
  name String
  participants String
  codeHash String
  variant String
  progress String
  sessions TeamSession[]
  insiderAccess InsiderAccess?
  taskScores TaskScore[]
  drafts ChapterDraft[]
  r2Finalist R2Finalist?
  insiderPairs InsiderPair[]
  wallCards InsiderWallCard[]
  groupMember InsiderGroupMember?
}
model InsiderAccess {
  teamId String @id
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fragmentA String @unique
  fragmentB String @unique
  unlockedAt DateTime?
}
// Evidence Wall (Insider chapter). CURRENT DESIGN ("group mode"): exactly ONE InsiderPair row per team = its assigned group A/B/C (10/10/10 for 30 teams), solved by its private slip + its own public wall card (InsiderWallCard.teamId).
// LEGACY three-pair mode (three rows per team) and the older two-fragment gate (no rows) stay readable and working. Earlier design note, three independent pairs per team: a PRIVATE slip (team-specific code, in the team's envelope) fits exactly one
// PUBLIC wall card of the team's variant. A solved pair opens its evidence folder; all three solved sets InsiderAccess.unlockedAt.
// No row for a team = legacy two-fragment unlock (InsiderAccess.fragmentA/B), unchanged.
model InsiderPair {
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  pair String // "A" | "B" | "C" (organizer-side structure; never printed on both halves)
  privateCode String @unique
  solvedAt DateTime?
  @@id([teamId, pair])
}
// Shared public cards per variant. The intended match and its decoys live ONLY in the event database (random codes), never in source.
model InsiderWallCard {
  code String @id
  variant String
  pair String
  role String // "match" | "decoy"
  teamId String? // group mode: the one team this match card belongs to (decoys and legacy variant-level cards: null)
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  @@index([variant, pair])
  @@index([teamId])
}
// Evidence Wall, FINAL design ("shared pairs"): exactly SIX fragments for the whole event = Private A/Public A, Private B/Public B, Private C/Public C.
// Every team in a group shares that group's pair. The codes live ONLY here (random, created once, never regenerated); a team's membership is one row.
// Earlier per-team modes (InsiderPair / InsiderWallCard) stay readable; a team with a member row always uses this model.
model InsiderGroupCode {
  group String @id // "A" | "B" | "C"
  privateCode String @unique
  publicCode String @unique
  createdAt DateTime @default(now())
}
model InsiderGroupMember {
  teamId String @id
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  group String // "A" | "B" | "C"
  solvedAt DateTime?
  assignedAt DateTime @default(now())
  @@index([group])
}
model TeamSession {
  tokenHash String @id
  teamId String?
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role String
  expiresAt DateTime
}
model GameSession {
  id Int @id
  startsAt DateTime?
  deadline DateTime?
  endedAt DateTime?
  scoringPolicy String? // fixed when the round starts ("best-v1"); NULL on a round that started before policies existed = legacy "union-v0"
}
model Submission {
  id String @id @default(cuid())
  teamId String
  chapter Int
  accepted Boolean
  reason String
  answer String?
  // Task-scoring audit (NULL on every pre-v2 row): version, points newly awarded by this submission, chapter raw after it, criterion ids first earned by it.
  scoringVersion Int?
  awarded Int?
  chapterRaw Int?
  criteria String?
  taskId String? // best-v1 audit: task of a task submission (NULL = full-chapter submission)
  answerHash String? // best-v1: identical re-submissions are idempotent
  createdAt DateTime @default(now())
  @@index([teamId, createdAt])
  @@index([teamId, chapter, answerHash])
}
model AuditLog {
  id String @id @default(cuid())
  actor String
  action String
  detail String
  createdAt DateTime @default(now())
}
model LoginAttempt {
  key String @id
  failures Int
  windowStart DateTime
}

// Best-ever earned criteria per task. Monotonic: criteria are only ever added, never removed.
model TaskScore {
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  chapter Int
  taskId String
  earned Int
  max Int
  criteria String // JSON array of earned criterion ids (best-v1: the criteria of the single best submission)
  attempts Int @default(0) // best-v1: distinct graded attempts used
  firstScoredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([teamId, taskId])
  @@index([teamId, chapter])
}
// Unscored work-in-progress answers, optimistic-locked by version.
model ChapterDraft {
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  chapter Int
  taskId String
  data String
  version Int @default(1)
  updatedAt DateTime @updatedAt
  @@id([teamId, chapter, taskId])
}

// ---------- Round 2 (GHOST RETURNS). Fully separate from Round 1 tables; the only link to Round 1 is the Team identity. ----------
// Single-row clock. startsAt is set once by an organizer; every phase boundary is derived from it (src/lib/round2/clock.ts).
model R2Session {
  id Int @id
  startsAt DateTime?
  endedAt DateTime?
  resultsPublishedAt DateTime?
  contentVersion String?
  scoringPolicy String? // fixed at start ("best-v1"); NULL on a legacy session = "union-v0"
  format String? // fixed at start: "paper-40" (sequential, default) or "open-60" (case document v2). NULL = paper-40
}
// Inject 2 terminal (open-60 format only). One row per consumed BLOCK attempt. The (team, session start, seq) key makes the 4-attempt budget
// impossible to exceed even with concurrent tabs: seq is 1..4 and a fifth row cannot be created. result: caught | cleared | repeat.
model R2BlockAttempt {
  id Int @id @default(autoincrement())
  teamId String
  sessionStartsAt DateTime
  seq Int
  ip String
  result String
  createdAt DateTime @default(now())
  @@unique([teamId, sessionStartsAt, seq])
  @@index([teamId, sessionStartsAt])
}
// Enrollment from the organizer-confirmed qualification snapshot. status: active | standby | withdrawn.
model R2Finalist {
  teamId String @id
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  status String
  seed Int
  snapshotDigest String
  note String @default("")
  enrolledAt DateTime @default(now())
  statusChangedAt DateTime @default(now())
  submissions R2Submission[]
  scores R2TaskScore[]
  drafts R2Draft[]
  @@index([status])
}
// Append-only record of every graded attempt (answer hash makes identical re-submissions idempotent).
model R2Submission {
  id String @id @default(cuid())
  teamId String
  finalist R2Finalist @relation(fields: [teamId], references: [teamId], onDelete: Restrict)
  taskId String
  awarded Int
  taskEarned Int
  criteria String // JSON array: criterion ids first earned by this attempt
  answerHash String
  answer String
  contentVersion String
  scoringPolicy String? // policy in force when graded
  createdAt DateTime @default(now())
  @@index([teamId, taskId, createdAt])
  @@index([teamId, createdAt])
}
// Best-ever earned criteria per task. Monotonic: criteria are only ever added.
model R2TaskScore {
  teamId String
  finalist R2Finalist @relation(fields: [teamId], references: [teamId], onDelete: Restrict)
  taskId String
  part String
  earned Int
  max Int
  criteria String // JSON array of earned criterion ids
  firstScoredAt DateTime @default(now())
  lastAwardAt DateTime @default(now()) // server time of the last attempt that added points (Part A timing tiebreak)
  @@id([teamId, taskId])
  @@index([teamId, part])
}
model R2Draft {
  teamId String
  finalist R2Finalist @relation(fields: [teamId], references: [teamId], onDelete: Restrict)
  taskId String
  data String
  version Int @default(1)
  updatedAt DateTime @updatedAt
  @@id([teamId, taskId])
}
// Organizer and system actions for Round 2 only (Round 1 keeps AuditLog).
model R2Audit {
  id String @id @default(cuid())
  actor String
  action String
  detail String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
// Jury marks for the paper injects (1, 3, 4) of the 60-minute Round 2, per session. Inject 2 is never stored: the terminal computes it.
// No row = pending (never zero). Every change is written to R2Audit with the previous value.
model R2PaperMark {
  teamId String
  sessionStartsAt DateTime
  inject Int
  score Int
  marker String
  updatedAt DateTime @default(now())
  @@id([teamId, sessionStartsAt, inject])
}
// Append-only acknowledgment that an organizer has seen an EXACT Round 2 tie (equal on all four ranking criteria) and accepts the shared rank.
// It never changes a score, a rank or an order. `signature` fingerprints the tie group, so one group can be acknowledged once.
model R2TieAck {
  id String @id @default(cuid())
  rank Int
  teamIds String // JSON array of the tied team ids (sorted)
  signature String @unique
  reason String
  decidedBy String
  createdAt DateTime @default(now())
}
