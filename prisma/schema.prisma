generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon pgbouncer) connection used by the application
  directUrl = env("DIRECT_URL")   // direct connection used by prisma migrate
}
model Team {
  id String @id
  name String
  participants String
  codeHash String
  variant String
  progress String
  sessions TeamSession[]
  insiderAccess InsiderAccess?
  taskScores TaskScore[]
  drafts ChapterDraft[]
  r2Finalist R2Finalist?
}
model InsiderAccess {
  teamId String @id
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fragmentA String @unique
  fragmentB String @unique
  unlockedAt DateTime?
}
model TeamSession {
  tokenHash String @id
  teamId String?
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role String
  expiresAt DateTime
}
model GameSession {
  id Int @id
  startsAt DateTime?
  deadline DateTime?
  endedAt DateTime?
  scoringPolicy String? // fixed when the round starts ("best-v1"); NULL on a round that started before policies existed = legacy "union-v0"
}
model Submission {
  id String @id @default(cuid())
  teamId String
  chapter Int
  accepted Boolean
  reason String
  answer String?
  // Task-scoring audit (NULL on every pre-v2 row): version, points newly awarded by this submission, chapter raw after it, criterion ids first earned by it.
  scoringVersion Int?
  awarded Int?
  chapterRaw Int?
  criteria String?
  taskId String? // best-v1 audit: task of a task submission (NULL = full-chapter submission)
  answerHash String? // best-v1: identical re-submissions are idempotent
  createdAt DateTime @default(now())
  @@index([teamId, createdAt])
  @@index([teamId, chapter, answerHash])
}
model AuditLog {
  id String @id @default(cuid())
  actor String
  action String
  detail String
  createdAt DateTime @default(now())
}
model LoginAttempt {
  key String @id
  failures Int
  windowStart DateTime
}

// Best-ever earned criteria per task. Monotonic: criteria are only ever added, never removed.
model TaskScore {
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  chapter Int
  taskId String
  earned Int
  max Int
  criteria String // JSON array of earned criterion ids (best-v1: the criteria of the single best submission)
  attempts Int @default(0) // best-v1: distinct graded attempts used
  firstScoredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([teamId, taskId])
  @@index([teamId, chapter])
}
// Unscored work-in-progress answers, optimistic-locked by version.
model ChapterDraft {
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  chapter Int
  taskId String
  data String
  version Int @default(1)
  updatedAt DateTime @updatedAt
  @@id([teamId, chapter, taskId])
}

// ---------- Round 2 (GHOST RETURNS). Fully separate from Round 1 tables; the only link to Round 1 is the Team identity. ----------
// Single-row clock. startsAt is set once by an organizer; every phase boundary is derived from it (src/lib/round2/clock.ts).
model R2Session {
  id Int @id
  startsAt DateTime?
  endedAt DateTime?
  resultsPublishedAt DateTime?
  contentVersion String?
  scoringPolicy String? // fixed at start ("best-v1"); NULL on a legacy session = "union-v0"
}
// Enrollment from the organizer-confirmed qualification snapshot. status: active | standby | withdrawn.
model R2Finalist {
  teamId String @id
  team Team @relation(fields: [teamId], references: [id], onDelete: Restrict)
  status String
  seed Int
  snapshotDigest String
  note String @default("")
  enrolledAt DateTime @default(now())
  statusChangedAt DateTime @default(now())
  submissions R2Submission[]
  scores R2TaskScore[]
  drafts R2Draft[]
  @@index([status])
}
// Append-only record of every graded attempt (answer hash makes identical re-submissions idempotent).
model R2Submission {
  id String @id @default(cuid())
  teamId String
  finalist R2Finalist @relation(fields: [teamId], references: [teamId], onDelete: Restrict)
  taskId String
  awarded Int
  taskEarned Int
  criteria String // JSON array: criterion ids first earned by this attempt
  answerHash String
  answer String
  contentVersion String
  scoringPolicy String? // policy in force when graded
  createdAt DateTime @default(now())
  @@index([teamId, taskId, createdAt])
  @@index([teamId, createdAt])
}
// Best-ever earned criteria per task. Monotonic: criteria are only ever added.
model R2TaskScore {
  teamId String
  finalist R2Finalist @relation(fields: [teamId], references: [teamId], onDelete: Restrict)
  taskId String
  part String
  earned Int
  max Int
  criteria String // JSON array of earned criterion ids
  firstScoredAt DateTime @default(now())
  lastAwardAt DateTime @default(now()) // server time of the last attempt that added points (Part A timing tiebreak)
  @@id([teamId, taskId])
  @@index([teamId, part])
}
model R2Draft {
  teamId String
  finalist R2Finalist @relation(fields: [teamId], references: [teamId], onDelete: Restrict)
  taskId String
  data String
  version Int @default(1)
  updatedAt DateTime @updatedAt
  @@id([teamId, taskId])
}
// Organizer and system actions for Round 2 only (Round 1 keeps AuditLog).
model R2Audit {
  id String @id @default(cuid())
  actor String
  action String
  detail String
  createdAt DateTime @default(now())
  @@index([createdAt])
}
