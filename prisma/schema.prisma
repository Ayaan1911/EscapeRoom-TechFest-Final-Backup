generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled (Neon pgbouncer) connection used by the application
  directUrl = env("DIRECT_URL")   // direct connection used by prisma migrate
}
model Team {
  id String @id
  name String
  participants String
  codeHash String
  variant String
  progress String
  sessions TeamSession[]
  insiderAccess InsiderAccess?
  taskScores TaskScore[]
  drafts ChapterDraft[]
}
model InsiderAccess {
  teamId String @id
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  fragmentA String @unique
  fragmentB String @unique
  unlockedAt DateTime?
}
model TeamSession {
  tokenHash String @id
  teamId String?
  team Team? @relation(fields: [teamId], references: [id], onDelete: Cascade)
  role String
  expiresAt DateTime
}
model GameSession {
  id Int @id
  startsAt DateTime?
  deadline DateTime?
  endedAt DateTime?
}
model Submission {
  id String @id @default(cuid())
  teamId String
  chapter Int
  accepted Boolean
  reason String
  answer String?
  // Task-scoring audit (NULL on every pre-v2 row): version, points newly awarded by this submission, chapter raw after it, criterion ids first earned by it.
  scoringVersion Int?
  awarded Int?
  chapterRaw Int?
  criteria String?
  createdAt DateTime @default(now())
  @@index([teamId, createdAt])
}
model AuditLog {
  id String @id @default(cuid())
  actor String
  action String
  detail String
  createdAt DateTime @default(now())
}
model LoginAttempt {
  key String @id
  failures Int
  windowStart DateTime
}

// Best-ever earned criteria per task. Monotonic: criteria are only ever added, never removed.
model TaskScore {
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  chapter Int
  taskId String
  earned Int
  max Int
  criteria String // JSON array of earned criterion ids
  firstScoredAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@id([teamId, taskId])
  @@index([teamId, chapter])
}
// Unscored work-in-progress answers, optimistic-locked by version.
model ChapterDraft {
  teamId String
  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  chapter Int
  taskId String
  data String
  version Int @default(1)
  updatedAt DateTime @updatedAt
  @@id([teamId, chapter, taskId])
}
