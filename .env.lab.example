# GHOST_404 lab LAN configuration. Copy to .env.lab (git-ignored) and fill in. NEVER commit .env.lab.
# The database name MUST start with ghost404_lab - the lab scripts refuse anything else (never the demo/competition databases).
# Local PostgreSQL on the server PC (recommended for a college LAN; no internet needed):
DATABASE_URL=postgresql://<db-user>:<db-password>@127.0.0.1:5432/ghost404_lab
DIRECT_URL=postgresql://<db-user>:<db-password>@127.0.0.1:5432/ghost404_lab
# Set with: scripts\lab\prepare-lab.ps1 -SetOrganizerCode   (stores only a hash)
ADMIN_ACCESS_HASH=
# Optional
LAB_PORT=3000
# LAB_HOST_IP=192.168.x.x          # only if the script picks the wrong adapter
# DB_POOL_SIZE=10
# Only for a dedicated, separate remote lab database (its own Neon project, name still ghost404_lab*):
# GHOST_LAB_ALLOW_REMOTE_DB=1
