{
  "name": "operation-ghost-404",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "start:render": "prisma migrate deploy && next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "teams:provision": "node --env-file=.env scripts/provision-teams.mjs",
    "load:round1": "node scripts/load-test.mjs",
    "db:backup": "node --env-file=.env scripts/db-backup.mjs backup backups",
    "db:test:up": "docker run -d --name ghost404-pg-test -e POSTGRES_PASSWORD=ghosttest -p 127.0.0.1:55432:5432 postgres:15-alpine",
    "db:seed": "node --env-file=.env scripts/seed.mjs",
    "auth:hash": "powershell -NoProfile -File scripts/hash.ps1",
    "demo:inbox": "node scripts/inbox-demo.mjs",
    "test:e2e:inbox": "node scripts/inbox-demo.mjs --test",
    "rehearsal:round1": "node scripts/inbox-demo.mjs --rehearsal",
    "demo:trail": "node scripts/inbox-demo.mjs --trail",
    "test:e2e:trail": "node scripts/inbox-demo.mjs --test --trail",
    "demo:insider": "node scripts/inbox-demo.mjs --insider",
    "test:e2e:insider": "node scripts/inbox-demo.mjs --test --insider",
    "demo:containment": "node scripts/inbox-demo.mjs --containment",
    "test:e2e:containment": "node scripts/inbox-demo.mjs --test --containment",
    "demo:verdict": "node scripts/inbox-demo.mjs --verdict",
    "test:e2e:verdict": "node scripts/inbox-demo.mjs --test --verdict",
    "test:e2e:journey": "node scripts/inbox-demo.mjs --test --journey"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "next": "^16.3.0",
    "qrcode": "1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.3.0",
    "jsqr": "1.4.0",
    "postcss": "^8.0.0",
    "prisma": "^6.19.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.9.0",
    "vitest": "^4.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2"
  }
}
