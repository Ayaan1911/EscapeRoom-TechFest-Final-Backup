# PostgreSQL (Neon). Never commit real values; copy this file to .env (git-ignored) or set them in the host dashboard.
# Pooled connection used by the running app (Neon "pooled" host, contains -pooler):
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&pgbouncer=true&connect_timeout=30"
# Direct connection used ONLY by `prisma migrate` and the backup/provisioning scripts (no -pooler):
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DBNAME?sslmode=require&connect_timeout=30"
# Local disposable test server (npm run db:test:up) - used by tests, demos and the load harness, never for real data:
#   GHOST_PG_ADMIN_URL="postgresql://postgres:ghosttest@127.0.0.1:55432/postgres"
# Optional: application connection pool size (default 5; Neon Free pooler handles many clients, keep this small).
# DB_POOL_SIZE=5
# Generate with: $env:GHOST_BOOTSTRAP_SECRET='<12+ chars>'; node scripts/bootstrap.mjs   (hash only is stored)
ADMIN_ACCESS_HASH=
# Exact public origin. Production session cookies are Secure, so participants need an https:// origin.
APP_ORIGIN="http://localhost:3000"
# Development seed only (never for real teams; use npm run teams:provision instead). Never commit values.
DEV_TEAM_CODE=
DEV_TEAM_COUNT=3
