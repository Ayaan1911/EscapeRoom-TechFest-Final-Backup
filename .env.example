DATABASE_URL="file:./dev.db"
# Generate with npm run auth:hash (reads secret from hidden terminal input).
ADMIN_ACCESS_HASH=
# Set to the exact public origin; HTTPS is required in production.
APP_ORIGIN="http://localhost:3000"
# Development seed requires these environment values; never commit them.
DEV_TEAM_CODE=
DEV_TEAM_COUNT=3
